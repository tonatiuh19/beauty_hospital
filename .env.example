# ─────────────────────────────────────────────────────────────────────────────
# All Beauty Luxury & Wellness — Environment Variables
# Copy this file to .env and fill in real values. Never commit .env to git.
# ─────────────────────────────────────────────────────────────────────────────

# ── App ───────────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=8080
# Public URL (no trailing slash). Used in emails, check-in links, CORS.
APP_URL=http://localhost:8080
CLIENT_URL=http://localhost:8080

# ── JWT ──────────────────────────────────────────────────────────────────────
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change_me_random_64_chars
JWT_EXPIRES_IN=24h
JWT_REFRESH_SECRET=change_me_different_random_64_chars
JWT_REFRESH_EXPIRES_IN=7d

# ── Database (TiDB Cloud Serverless / MySQL 8.0) ─────────────────────────────
DB_HOST=gateway01.us-east-1.prod.aws.tidbcloud.com
DB_PORT=4000
DB_USER=your_db_user
DB_PASSWORD=your_db_password
DB_NAME=all-beauty
DB_SSL=true

# ── Email (Resend) ────────────────────────────────────────────────────────────
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxx
SMTP_FROM=All Beauty Luxury & Wellness <no-reply@yourdomain.com>

# ── Stripe ────────────────────────────────────────────────────────────────────
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key
STRIPE_PUBLISHABLE_KEY=pk_test_your_stripe_publishable_key
VITE_STRIPE_PUBLISHABLE_KEY=pk_test_your_stripe_publishable_key
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret

# ── Twilio (SMS / WhatsApp — optional) ────────────────────────────────────────
TWILIO_ACCOUNT_SID=your_twilio_account_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886

# ── Storage ───────────────────────────────────────────────────────────────────
# Static images: public/assets/ (no Blob). Uploads: Vercel Blob.
# Create a Blob store in the Vercel dashboard, then `vercel env pull`.
BLOB_READ_WRITE_TOKEN=
# Optional email logo override (absolute HTTPS). Default: inline CID from
# public/assets/logo-header.png, then {APP_URL}/api/brand/logo
BRAND_LOGO_URL=
MAX_FILE_SIZE=10485760
ALLOWED_FILE_TYPES=image/jpeg,image/png,image/gif,application/pdf

# ── Clinic ────────────────────────────────────────────────────────────────────
# Used for "today" metrics, blocked-date defaults, and dashboard charts.
CLINIC_TIMEZONE=America/Mexico_City

# ── Misc ──────────────────────────────────────────────────────────────────────
PING_MESSAGE=pong
